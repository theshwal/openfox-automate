{
  "name": "openfox-automate",
  "version": "0.1.0",
  "description": "OpenFox plugin: scan GitHub issues, order them intelligently, spawn sessions, run a configurable chain of workflows end-to-end.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "README.fr.md"
  ],
  "scripts": {
    "build": "test -f dist/index.js || tsc; test -f dist/panel.html || test -f src/panel/panel.html && cp src/panel/panel.html dist/panel.html",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "vitest run test/e2e",
    "lint": "eslint . --ext .ts",
    "lint:fix": "eslint . --ext .ts --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write ."
  },
  "openfox": {
    "apiVersion": 2,
    "entry": "./dist/index.js",
    "displayName": "OpenFox Automate",
    "description": "Autonomous GitHub issue processing: scan, order, spawn sessions, run a workflow chain.",
    "capabilities": [
      "tools",
      "settings",
      "ui",
      "rpc",
      "hooks",
      "notifications"
    ],
    "timeoutMs": 30000
  },
  "keywords": [
    "openfox",
    "openfox-plugin",
    "github",
    "issues",
    "automation",
    "workflows"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "openfox": ">=2.0.140",
    "zod": "^3.23.0"
  },
  "peerDependenciesMeta": {
    "openfox": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.0.0",
    "@vitest/coverage-v8": "^2.1.0",
    "eslint": "^9.39.5",
    "prettier": "^3.9.9",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.1",
    "vitest": "^2.1.0"
  }
}
